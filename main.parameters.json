{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "prefix": {
      "value": "srelab"
    },
    "adminUsername": {
      "value": "azureuser"
    },
    "sshPublicKey": {
      "value": "<YOUR_SSH_PUBLIC_KEY>"
    },
    "alertEmail": {
      "value": "<YOUR_EMAIL_ADDRESS>"
    },
    "allowedSshSource": {
      "value": "<YOUR_PUBLIC_IP>/32"
    },
    "vmSize": {
      "value": "Standard_B2s"
    },
    "sreAgentName": {
      "value": "srelab-agent"
    },
    "sreAgentAccessLevel": {
      "value": "High"
    },
    "sreAgentMode": {
      "value": "Review"
    },
    "deployerPrincipalId": {
      "value": "<YOUR_AZURE_AD_OBJECT_ID>"
    }
  }
}
